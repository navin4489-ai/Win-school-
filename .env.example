# Wintech School ERP – configuration reference.
# Copy to .env (never commit real values). In production these are set as environment
# variables on Render (see render.yaml). ASP.NET uses "__" for nested keys.

# --- Required ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Postgres URL (postgres://user:pass@host:5432/db) or key/value connection string.
ConnectionStrings__Default=
Database__Provider=Postgres
# At least 32 random characters. Startup fails in Production if missing or a dev key.
Jwt__SigningKey=
# Web portal origin(s). Startup fails in Production if empty.
Cors__AllowedOrigins__0=https://school.wintechinov.com
# Shared secret (24+ chars) for the scheduled jobs endpoint /api/jobs/run.
Jobs__Secret=

# --- First start only: creates the platform super admin -----------------------
Bootstrap__SchoolCode=WINTECH
Bootstrap__SchoolName=Wintech Innovations
Bootstrap__AdminEmail=
# 12+ characters, letters and digits.
Bootstrap__AdminPassword=

# --- Optional (defaults shown) -----------------------------------------------
Jwt__Issuer=SchoolErp
Jwt__Audience=SchoolErp.Clients
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7
RateLimiting__PermitsPerMinute=1200
# Sign-in attempts per minute per IP.
RateLimiting__LoginPerMinute=10
# Online fee payment: "Disabled" (pay at office) or "Dummy" (test only, refused in Production).
Payments__Provider=Disabled
# Uploads: "Database" (survives redeploys) or "Local" (disk at Storage__RootPath).
Storage__Provider=Database
Storage__MaxFileSizeBytes=10485760
# Late fee: amount per day after PayByDay, capped at a % of the installment.
Fees__Penalty__DailyAmount=10
Fees__Penalty__PayByDay=15
Fees__Penalty__MaxPercentageOfFee=25
Library__FinePerDay=5
# Local "today" for attendance, receipts and due dates.
SCHOOL_TIME_ZONE=Asia/Kolkata
