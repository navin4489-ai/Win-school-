{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "SchoolErp",
    "Audience": "SchoolErp.Clients",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 30
  },
  "Payments": {
    "Provider": "Disabled"
  },
  "Storage": {
    "RootPath": "App_Data/uploads",
    "PublicBaseUrl": "/files",
    "MaxFileSizeBytes": 10485760
  },
  "AppDownload": {
    "ApkPath": "App_Data/app/WintechSchool.apk",
    "FileName": "WintechSchool.apk",
    "MaxUploadBytes": 209715200
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:8100"
    ]
  },
  "RateLimiting": {
    "PermitsPerMinute": 1200
  },
  "Fees": {
    "Penalty": {
      "DailyAmount": 10,
      "PayByDay": 15,
      "MaxPercentageOfFee": 25,
      "IntervalMinutes": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
