{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=SchoolErp;User Id=sa;Password=Your_password123;TrustServerCertificate=True;Encrypt=True"
  },
  "Jwt": {
    "Issuer": "SchoolErp",
    "Audience": "SchoolErp.Clients",
    "SigningKey": "dev-only-change-me-please-32-chars-minimum-key",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 30
  },
  "Storage": {
    "RootPath": "App_Data/uploads",
    "PublicBaseUrl": "/files",
    "MaxFileSizeBytes": 10485760
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:8100"
    ]
  },
  "Seed": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
